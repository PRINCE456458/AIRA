# Copy this file to a new file called .env and fill it in. NEVER upload .env to GitHub.

# --- The AI service (any "OpenAI compatible" service works) ---
# Type values WITHOUT quotes and without spaces. To test on your own laptop with Ollama (no key needed):
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=

# For an online AI service, use its address, a current model name from its dashboard, and your key.
# Google Gemini address: https://generativelanguage.googleapis.com/v1beta/openai
# Groq address:          https://api.groq.com/openai/v1

# --- Online database (needed on Vercel, optional on your laptop) ---
# Make a free database at turso.tech, then paste its address (starts with libsql://) and its token here.
# Leave both empty on your laptop: Aira then saves to a small local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: let Aira look at photos ---
# Needs a model that can see images (for Ollama: ollama pull moondream, then AI_VISION_MODEL=moondream).
# Leave empty to hide the Photo button.
AI_VISION_MODEL=

# --- Web search (free, no key). Set to 0 to turn off ---
SEARCH_ENABLED=1

# --- Limits that protect your free quota ---
USER_PER_DAY=80
IMAGES_PER_DAY=10
BUILDER_MAX_TOKENS=3500
PER_DAY=40
PER_MINUTE=8
GLOBAL_PER_DAY=1500

# --- Your pages ---
SITE_NAME=Aira
INSTAGRAM_URL=
# Leave empty to keep your phone number off the website:
WHATSAPP_NUMBER=

# --- Reading feedback at /admin (choose a long password) ---
ADMIN_PASSWORD=

# Set to 1 when the site runs behind a host like Render or Railway:
TRUST_PROXY=0
